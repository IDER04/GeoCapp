# Copiez ce fichier vers .streamlit/secrets.toml et renseignez votre clé.
# Ne commitez jamais secrets.toml : il est exclu par .gitignore.
# La clé peut aussi être définie dans un fichier .env à la racine (prioritaire).
OPENROUTER_API_KEY = "sk-or-..."

# Modèle : "openrouter/free" utilise un modèle gratuit d'OpenRouter ; sinon p. ex. "openai/gpt-4o".
LLM_MODEL = "openrouter/free"
# URL de base de l'API compatible OpenAI (https obligatoire). Défaut : OpenRouter.
LLM_BASE_URL = "https://openrouter.ai/api/v1"

# Ancien nom du modèle, toujours accepté (LLM_MODEL est prioritaire) :
# GEOCAPITAL_MODEL = "openai/gpt-4o"
